# Base de datos SQLite
DATABASE_URL="file:./portfolio.db"

# Trading 212 API
# Tu API Key generada en Trading 212 (Ajustes -> API)
T212_API_KEY=""
# URL base: "https://live.trading212.com/api/v0" para cuenta real
T212_BASE_URL="https://live.trading212.com/api/v0"

# Opciones de sincronización
# Hora diaria del snapshot (en formato cron, ej: "0 21 * * 1-5" para Lunes-Viernes a las 21:00)
SNAPSHOT_CRON="0 21 * * *"

# Si no hay API key configurada o falla la conexión, la app puede mostrar datos de demostración realistas
ENABLE_DEMO_FALLBACK="true"

# Google Gemini API Key para el Asesor DCA IA
GEMINI_API_KEY=""
